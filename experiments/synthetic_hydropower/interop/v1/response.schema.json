{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthetic-hydropower/v1/response.schema.json",
  "title": "Synthetic hydropower v1 batch response",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": "synthetic-hydropower/v1"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "power", "simulation"],
        "properties": {
          "case_id": {"type": "string"},
          "power": {"type": "object"},
          "simulation": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"required": ["results"]},
    {"required": ["error"]}
  ],
  "additionalProperties": false
}
