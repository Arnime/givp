{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthetic-hydropower/v1/request.schema.json",
  "title": "Synthetic hydropower v1 batch request",
  "type": "object",
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": {"const": "synthetic-hydropower/v1"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "incremental_inflow_m3s", "target_power_mw"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "incremental_inflow_m3s": {"$ref": "#/$defs/twoPlantHourlyMatrix"},
          "target_power_mw": {"$ref": "#/$defs/twoPlantHourlyMatrix"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "twoPlantHourlyMatrix": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 24,
        "maxItems": 24,
        "items": {"type": "number"}
      }
    }
  }
}
