url: "https://doi.org/10.5281/zenodo.22185079"
license: CC-BY-4.0
repository-code: "https://github.com/Arnime/givp"
keywords:
  - hydropower
  - water balance
  - synthetic benchmark
  - optimization
  - GRASP
  - reproducibility
