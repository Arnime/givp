CompileFlags:
  # Use compile_commands.json from the default build if available,
  # otherwise fall back to manual include paths below.
  CompilationDatabase: cpp/build/default

  Add:
    - -std=c++17
    - -Icpp/include
    - -Icpp/include/givp
  
  Remove:
    # Remove -W* flags that clangd handles natively
    - -W*
    - -Werror*

  # Clangd fallback behavior when compile_commands.json is not found
Hover:
  ShowAKA: true

