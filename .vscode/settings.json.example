{
    // ─── Editor ──────────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.rulers": [
        88,
        100
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.renderWhitespace": "boundary",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    // ─── Theme & Icons ───────────────────────────────────────────────────────
    "workbench.colorTheme": "Dark Modern",
    "workbench.iconTheme": "material-icon-theme",
    // Exibe os clones Git locais em cpp/ no painel Source Control.
    "git.autoRepositoryDetection": "subFolders",
    "git.detectSubmodules": true,
    // Ícones de pastas do Material Icon Theme para a estrutura deste projeto.
    "material-icon-theme.folders.customClones": [
        {
            "name": "givp-cpp",
            "base": "include",
            "color": "#42A5F5",
            "folderNames": ["cpp"]
        },
        {
            "name": "givp-julia",
            "base": "project",
            "color": "#AB47BC",
            "folderNames": ["julia"]
        },
        {
            "name": "givp-results",
            "base": "export",
            "color": "#FFB300",
            "folderNames": ["results"]
        },
        {
            "name": "givp-conan-registry",
            "base": "packages",
            "color": "#5C6BC0",
            "folderNames": ["conan-center-index"]
        },
        {
            "name": "givp-vcpkg-registry",
            "base": "packages",
            "color": "#1E88E5",
            "folderNames": ["vcpkg"]
        }
    ],
    // ─── Python ──────────────────────────────────────────────────────────────
    // O VS Code seleciona o ambiente Poetry detectado, sem fixar um executável.
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    // Pacote Python está em python/src/
    "python.analysis.extraPaths": [
        "${workspaceFolder}/python/src"
    ],
    // Mypy: usa o projeto Python do monorepo e a venv selecionada pelo Poetry.
    "mypy-type-checker.cwd": "${nearestConfig}",
    "mypy-type-checker.args": [
        "--config-file=${workspaceFolder}/python/pyproject.toml"
    ],
    "mypy-type-checker.importStrategy": "fromEnvironment",
    // Pylint: carrega a configuração do projeto Python e não analisa testes.
    "pylint.cwd": "${workspaceFolder}/python",
    "pylint.args": [
        "--rcfile=${workspaceFolder}/python/pyproject.toml"
    ],
    "pylint.ignorePatterns": [
        "**/python/tests/**/*.py"
    ],
    "pylint.importStrategy": "useBundled",
    // ─── Black (formatter) + Ruff (linter) ───────────────────────────────────
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "black-formatter.args": [
        "--line-length=88"
    ],
    "ruff.enable": true,
    "ruff.lint.enable": true,
    "ruff.format.enable": false,
    "ruff.organizeImports": true,
    // Evita bloquear .venv/Scripts/ruff.exe durante atualizações do Poetry.
    "ruff.importStrategy": "useBundled",
    // ─── Rust ────────────────────────────────────────────────────────────────
    // Crate Rust está em rust/; aponta o rust-analyzer para o Cargo.toml correto
    "rust-analyzer.linkedProjects": [
        "${workspaceFolder}/rust/Cargo.toml"
    ],
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.check.extraArgs": [
        "--",
        "-D",
        "warnings"
    ],
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    // ─── Julia ───────────────────────────────────────────────────────────────
    // Pacote Julia está em julia/
    "julia.environmentPath": "${workspaceFolder}/julia",
    "julia.enableTelemetry": false,
    "[julia]": {
        "editor.defaultFormatter": "julialang.language-julia",
        "editor.formatOnSave": true,
        "editor.tabSize": 4
    },
    // ─── Notebooks ───────────────────────────────────────────────────────────
    "notebook.output.scrolling": true,
    "notebook.lineNumbers": "on",
    "notebook.formatOnSave.enabled": true,
    "jupyter.notebookFileRoot": "${workspaceFolder}/Notebooks",
    // ─── YAML ────────────────────────────────────────────────────────────────
    "yaml.customTags": [
        "!python/name scalar"
    ],
    // ─── Terminal ────────────────────────────────────────────────────────────
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    // ─── Exclusões de ficheiros ───────────────────────────────────────────────
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/*.egg-info": true,
        "**/.mypy_cache": true,
        "**/target": true
    },
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/dist/**": true,
        "**/rust/target/**": true
    },
    "search.exclude": {
        "**/rust/target": true,
        "**/.venv": true,
        "**/site": true
    },
    // ─── Color Customizations ─────────────────────────────────────────────────
    "workbench.colorCustomizations": {
        "activityBar.background": "#1a1a2e",
        "activityBar.foreground": "#a9b1d6",
        "activityBar.activeBorder": "#7aa2f7",
        "activityBar.activeBackground": "#252540",
        "activityBarBadge.background": "#7aa2f7",
        "activityBarBadge.foreground": "#1a1a2e",
        "panel.border": "#0f3460",
        "statusBar.background": "#0f3460",
        "statusBar.foreground": "#c0caf5",
        "statusBar.border": "#7aa2f7",
        "statusBar.noFolderBackground": "#1a1a2e",
        "statusBar.debuggingBackground": "#bb9af7",
        "statusBar.debuggingForeground": "#1a1a2e",
        "titleBar.activeBackground": "#1a1a2e",
        "titleBar.activeForeground": "#c0caf5",
        "titleBar.inactiveBackground": "#16213e",
        "titleBar.border": "#0f3460"
    },
    // ─── CMake Tools ──────────────────────────────────────────────────────────
    "cmake.sourceDirectory": "${workspaceFolder}/cpp",
    "cmake.buildDirectory": "${workspaceFolder}/cpp/build",
    "cmake.preferredGenerators": [
        "Ninja",
        "Unix Makefiles"
    ],
    "cmake.configureOnOpen": false,
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DGIVP_BUILD_TESTS=ON",
        "-DGIVP_BUILD_BENCHMARKS=ON"
    ],
    "cmake.setBuildTypeOnMultiConfig": false,
    "cmake.parallelJobs": 4,
    // ─── C/C++ IntelliSense: Use clangd (disables Microsoft C++ extension) ───
    "clangd.enabled": true,
    "[cpp]": {
        "editor.defaultFormatter": null,
        "editor.formatOnSave": false
    },
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/cpp/build/default",
        "--path-mappings=${workspaceFolder}=/mnt/d/Projetos Pessoais/GIVP",
        "--header-insertion=never",
        "--query-driver=C:/Strawberry/c/bin/*,**/cl.exe,**/g++,**/clang++"
    ],
    "clangd.fallbackFlags": [
        "-std=c++17",
        "-I",
        "${workspaceFolder}/cpp/include",
        "-I",
        "${workspaceFolder}/cpp/include/givp",
        "-I",
        "${workspaceFolder}/cpp/build/default/_deps/nanobench-src/src/include",
        "-I",
        "${workspaceFolder}/cpp/build/default/_deps/catch2-build/generated-includes",
        "-I",
        "${workspaceFolder}/cpp/build/default/_deps/catch2-src/src"
    ],
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/cpp/build/default/compile_commands.json",
    // ─── File Associations ────────────────────────────────────────────────────
    "files.associations": {
        ".clangd": "yaml"
    },
    "python-envs.defaultEnvManager": "ms-python.python:poetry",
    "python-envs.defaultPackageManager": "ms-python.python:poetry",
    "sonarlint.connectedMode.project": {
        "connectionId": "arnime",
        "projectKey": "Arnime_grasp_ils_vnd_pr"
    }
}
