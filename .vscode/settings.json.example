{
    "editor.formatOnSave": true,
    "editor.rulers": [
        88,
        100
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.renderWhitespace": "boundary",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.extraPaths": [
        "${workspaceFolder}/python/src"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "black-formatter.args": [
        "--line-length=88"
    ],
    "ruff.enable": true,
    "ruff.lint.enable": true,
    "ruff.format.enable": false,
    "ruff.organizeImports": true,
    "ruff.importStrategy": "fromEnvironment",
    "ruff.path": [
        "${workspaceFolder}/.venv/Scripts/ruff.exe"
    ],
    "rust-analyzer.linkedProjects": [
        "${workspaceFolder}/rust/Cargo.toml"
    ],
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.check.extraArgs": [
        "--",
        "-D",
        "warnings"
    ],
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "julia.environmentPath": "${workspaceFolder}/julia",
    "julia.enableTelemetry": false,
    "[julia]": {
        "editor.defaultFormatter": "julialang.language-julia",
        "editor.formatOnSave": true,
        "editor.tabSize": 4
    },
    "notebook.output.scrolling": true,
    "notebook.lineNumbers": "on",
    "notebook.formatOnSave.enabled": true,
    "jupyter.notebookFileRoot": "${workspaceFolder}/Notebooks",
    "yaml.customTags": [
        "!python/name scalar"
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/*.egg-info": true,
        "**/.mypy_cache": true,
        "**/target": true
    },
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/dist/**": true,
        "**/rust/target/**": true
    },
    "search.exclude": {
        "**/rust/target": true,
        "**/.venv": true,
        "**/site": true
    },
    "workbench.colorCustomizations": {
        "activityBar.background": "#1a1a2e",
        "activityBar.foreground": "#a9b1d6",
        "activityBar.activeBorder": "#7aa2f7",
        "activityBar.activeBackground": "#252540",
        "activityBarBadge.background": "#7aa2f7",
        "activityBarBadge.foreground": "#1a1a2e",
        "panel.border": "#0f3460",
        "statusBar.background": "#0f3460",
        "statusBar.foreground": "#c0caf5",
        "statusBar.border": "#7aa2f7",
        "statusBar.noFolderBackground": "#1a1a2e",
        "statusBar.debuggingBackground": "#bb9af7",
        "statusBar.debuggingForeground": "#1a1a2e",
        "titleBar.activeBackground": "#1a1a2e",
        "titleBar.activeForeground": "#c0caf5",
        "titleBar.inactiveBackground": "#16213e",
        "titleBar.border": "#0f3460"
    },
    "cmake.sourceDirectory": "${workspaceFolder}/cpp",
    "cmake.buildDirectory": "${workspaceFolder}/cpp/build/default",
    "cmake.configureOnOpen": false,
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DGIVP_BUILD_TESTS=ON",
        "-DGIVP_BUILD_BENCHMARKS=OFF"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.intelliSenseEngine": "Tag Parser",
    "python-envs.defaultEnvManager": "ms-python.python:poetry",
    "python-envs.defaultPackageManager": "ms-python.python:poetry"
}